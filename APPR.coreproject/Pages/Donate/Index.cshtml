@page
@model APPR.coreproject.Pages.Donate.IndexModel

@{
    ViewData["Title"] = "Donate";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">

            <h1>Make a Donation</h1>

            <p>Your contribution helps support our foundation.</p>

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>

                <div class="mb-3">
                    <label asp-for="Donation.DonorName"
                           class="form-label">
                        Full Name
                    </label>

                    <input asp-for="Donation.DonorName"
                           class="form-control" />

                    <span asp-validation-for="Donation.DonorName"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Donation.DonorEmail"
                           class="form-label">
                        Email
                    </label>

                    <input asp-for="Donation.DonorEmail"
                           class="form-control" />

                    <span asp-validation-for="Donation.DonorEmail"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Donation.Amount"
                           class="form-label">
                        Donation Amount
                    </label>

                    <input asp-for="Donation.Amount"
                           class="form-control"
                           type="number"
                           min="1"
                           step="0.01" />

                    <span asp-validation-for="Donation.Amount"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Donation.Currency"
                           class="form-label">
                        Currency
                    </label>

                    <select asp-for="Donation.Currency"
                            class="form-select">

                        <option value="">Select currency</option>
                        <option value="ZAR">ZAR</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                        <option value="GBP">GBP</option>

                    </select>

                    <span asp-validation-for="Donation.Currency"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Donation Type
                    </label>

                    <select asp-for="Donation.DonationType"
                            class="form-select">

                        <option value="">Select donation type</option>
                        <option value="One-Time">One-Time</option>
                        <option value="Monthly">Monthly Recurring</option>
                        <option value="Yearly">Yearly Recurring</option>

                    </select>

                    <span asp-validation-for="Donation.DonationType"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-primary">
                    Submit Donation
                </button>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}